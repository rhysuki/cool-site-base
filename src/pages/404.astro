---
// an 404.astro page automatically gets displayed whenever you visit a link that
// doesn't already route to a page.
//
// https://docs.astro.build/en/basics/astro-pages/#custom-404-error-page
import BasicPageLayout from "../layouts/BasicPageLayout.astro";
---

<BasicPageLayout>
    <div class="text-center">
        <h1>404</h1>
        <p>the page you were looking for doesn't exist!</p>
    </div>
</BasicPageLayout>
