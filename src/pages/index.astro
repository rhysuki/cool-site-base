---
import BasicPageLayout from "../layouts/BasicPageLayout.astro";
---

<!--
when using a layout, you just import it in the frontmatter and use it basically
like a regular HTML element, putting the contents of your page inside.

these contents will replace the layout's <slot/> element.
-->
<BasicPageLayout>
	<h1>my cool site</h1>
	<p>
		hiya! welcome to nikki's cool site base. it's a FOSS ready-to-use layout
		for personal websites, with a particular eye to blogging and hosting
		your own projects.
	</p>

	<hr />

	<p>
		see the <a href="#">github page</a> for the source, and the <a href="#"
			>blogpost</a
		> for an overview of how to use it.
	</p>

	<!--
	"text-center" is a bootstrap class that positions elements in the middle of
	their parent elements (this also goes for images).
	-->
	<div class="text-center">
		<!--
		"mw-100" is another one that equates to "max-width: 100%;", which makes
		the image size down if the viewport becomes to small to fit it (otherwise
		it'd just overflow off to the side).
		-->
		<img class="mw-100" src="/images/icon_star.gif" />
		<img class="mw-100" src="/images/icon_mascot.png" />
		<img class="mw-100" src="/images/icon_star.gif" />
	</div>
</BasicPageLayout>
